{
  "name": "project-craft-launcher",
  "version": "1.1.0",
  "description": "Launcher oficial do Project Craft",
  "author": "Project Craft",
  "license": "MIT",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "build": "node scripts/build-distribution.cjs",
    "build:clean": "node scripts/clean-build.cjs",
    "release:launcher": "node scripts/publish-launcher.cjs",
    "release": "node scripts/publish.cjs",
    "watch": "node scripts/watch.cjs",
    "connection": "node scripts/connection.cjs"
  },
  "dependencies": {
    "adm-zip": "0.6.1",
    "minecraft-launcher-core": "3.18.2",
    "msmc": "5.0.5"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "br.projectcraft.launcher",
    "productName": "Project Craft",
    "copyright": "Copyright Â© 2026 Project Craft",
    "asar": true,
    "directories": {
      "output": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "release-public-key.pem"
    ],
    "win": {
      "target": [
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "ProjectCraft-${version}-${arch}.${ext}",
      "signAndEditExecutable": true
    },
    "msi": {
      "artifactName": "ProjectCraft-Setup-${version}-x64.msi",
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Project Craft",
      "runAfterFinish": false
    },
    "publish": {
      "provider": "github",
      "owner": "VagJr",
      "repo": "project-craft-launcher"
    }
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "request": "npm:@cypress/request@4.0.1",
    "uuid": "11.1.1"
  }
}
